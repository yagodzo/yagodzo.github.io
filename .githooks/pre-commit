#!/bin/sh
# Pre-commit хук: чистит пути к изображениям в _posts перед каждым коммитом.
#
# Активация (один раз в репозитории):
#   git config core.hooksPath .githooks
#
# После этого хук будет работать у всех, кто клонирует репозиторий
# и один раз выполнит эту команду (в отличие от .git/hooks, которая
# не попадает в git и не расшаривается между машинами).
#
# Хук намеренно блокирует коммит при любой ошибке: раньше он
# заканчивался "exit 0", из-за чего пропажа скрипта осталась
# незамеченной и картинки молча ломались на сайте несколько недель.

SCRIPT="scripts/fix-image-paths.js"

if [ ! -f "$SCRIPT" ]; then
  echo "pre-commit: не найден $SCRIPT — пути к изображениям не проверены." >&2
  echo "Восстановите скрипт или закоммитьте с --no-verify, если это осознанно." >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: не найден node — пути к изображениям не проверены." >&2
  exit 1
fi

if ! node "$SCRIPT"; then
  echo "pre-commit: не все ссылки на изображения удалось разрешить (см. выше)." >&2
  exit 1
fi

# Если скрипт что-то поправил, добавляем изменения в тот же коммит
git add _posts/*.md 2>/dev/null

exit 0
