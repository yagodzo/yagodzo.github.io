#!/bin/sh
# Нормализует пути к изображениям в _posts перед коммитом.
# Активация: git config core.hooksPath .githooks
#
# Хук блокирует коммит при любой ошибке: прежняя версия заканчивалась
# "exit 0", из-за чего пропажа скрипта осталась незамеченной на недели.

SCRIPT="scripts/fix-image-paths.js"

if [ ! -f "$SCRIPT" ]; then
  echo "pre-commit: не найден $SCRIPT" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: не найден node" >&2
  exit 1
fi

node "$SCRIPT" || exit 1

# Скрипт правит файлы на диске, а коммит собирается из индекса.
# Без возврата исправленных файлов в индекс уйдёт старое содержимое.
restage_posts() {
  git diff --cached --name-only --diff-filter=ACMR -z -- '_posts/*.md' |
    xargs -0 -r git add --
}

restage_posts
