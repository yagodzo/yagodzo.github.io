#!/bin/sh
# Pre-commit хук: чистит пути к изображениям в _posts перед каждым коммитом.
#
# Активация (один раз в репозитории):
#   git config core.hooksPath .githooks
#
# После этого хук будет работать у всех, кто клонирует репозиторий
# и один раз выполнит эту команду (в отличие от .git/hooks, которая
# не попадает в git и не расшаривается между машинами).

node scripts/fix-image-paths.js

# Если скрипт что-то поправил, добавляем изменения в тот же коммит
git add _posts/*.md 2>/dev/null

exit 0
